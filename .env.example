# Copy this file to .env and fill in the values you need.

# Default OCR provider used when the client doesn't specify one: "remote" or "openai"
OCR_PROVIDER=openai

# Remote LightOnOCR-2 (Ollama) provider
OCR_ENDPOINT=http://103.4.95.76:11434
OCR_MODEL=maternion/LightOnOCR-2
OCR_TIMEOUT_SECONDS=180

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=180
# "low" = cheapest fixed input-token cost per image; "high"/"auto" = more tokens, better detail
OPENAI_IMAGE_DETAIL=low
